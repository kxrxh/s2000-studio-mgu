index 5a6af20..e578635 100644
--- a/packages/theme-compiler/src/font/bake.ts
+++ b/packages/theme-compiler/src/font/bake.ts
@@ -99,4 +99,23 @@ export function bakeFamily(family: string): BakedFont {
   return bakeFont(family, new Uint8Array(readFileSync(file)));
 }
 
+/** Replace the display atlas cells that are supplied by the authored S2000 font. */
+export function bakeS2000Lcd(fontFile: Uint8Array): BakedFont {
+  const base = bakeFamily('display');
+  const lcd = bakeFont('display', fontFile);
+  const font = new TrueTypeFont(parseFontFile(fontFile));
+  const { cellW, cellH, cols, chars } = base.metrics;
+  for (let code = 0; code < chars.length; code++) {
+    if (font.glyphIndex(chars.charCodeAt(code)) === 0) continue;
+    const x = (code % cols) * cellW;
+    const y = Math.floor(code / cols) * cellH;
+    for (let row = 0; row < cellH; row++) {
+      const start = (y + row) * base.width + x;
+      base.pixels.set(lcd.pixels.subarray(start, start + cellW), start);
+    }
+    base.metrics.adv[code] = lcd.metrics.adv[code]!;
+  }
+  return base;
+}
+
