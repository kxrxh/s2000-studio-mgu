{
  "schemaVersion": 1,
  "id": "s2000-g20",
  "name": "S2000 · G20",
  "version": "0.1.0",
  "description": "Offline Studio development theme for the 2021 BMW G20 B48. Artwork adapted from the project’s authored S2000 geometry.",
  "license": "See project NOTICE",
  "vehicleProfile": "turbo-ice",
  "target": {
    "display": "kombi-id7-12.3"
  },
  "layout": {
    "width": 1920,
    "height": 720,
    "background": "$background"
  },
  "palettes": {
    "amber": {
      "name": "Amber",
      "colors": {
        "background": "#000000",
        "surface": "#100302",
        "text": "#edf0ea",
        "text-muted": "#ff6758",
        "accent": "#ff6b11",
        "track": "#291308",
        "success": "#50c878",
        "warning": "#ff5547",
        "danger": "#ff2010"
      }
    }
  },
  "palette": {
    "default": "amber"
  },
  "fonts": {
    "default": {
      "family": "display",
      "file": "s2000-lcd.ttf"
    }
  },
  "assets": {
