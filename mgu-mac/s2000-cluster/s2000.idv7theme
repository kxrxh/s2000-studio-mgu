      "width": 106,
      "height": 89,
      "visibleWhen": {
        "all": [
          {
            "not": {
              "signal": "engine.rpm",
              "op": "stale"
            }
          },
          {
            "signal": "engine.rpm",
            "op": "gte",
            "value": 250
          }
        ]
      },
      "props": {
        "asset": "rpm-band-1",
        "fit": "stretch"
      }
