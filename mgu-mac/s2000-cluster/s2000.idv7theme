      "x": 1004,
      "y": 568,
      "width": 200,
      "height": 54,
      "binding": {
        "signal": "engine.oil.temp",
        "fallback": "dash"
      },
      "props": {
        "format": "0",
        "layout": "inline",
        "showUnit": true,
        "valueStyle": {
          "size": 41,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        },
        "unitStyle": {
          "size": 18,
          "color": "$warning",
          "align": "center",
