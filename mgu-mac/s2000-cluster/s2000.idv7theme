      "x": 847,
      "y": 519,
      "width": 208,
      "height": 48,
      "props": {
        "style": {
          "size": 43,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        }
      }
    },
    {
      "id": "odometer",
      "name": "Odometer",
      "type": "value.digital",
      "x": 690,
      "y": 568,
      "width": 248,
      "height": 54,
      "binding": {
        "signal": "vehicle.odometer",
        "fallback": "dash"
      },
      "props": {
        "format": "000000",
        "layout": "inline",
        "showUnit": true,
        "valueStyle": {
          "size": 41,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        },
        "unitStyle": {
          "size": 18,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        }
      }
    },
    {
      "id": "oil-label",
