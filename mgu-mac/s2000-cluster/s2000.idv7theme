      "type": "image",
      "x": 1670,
      "y": 289,
      "width": 220,
      "height": 119,
      "props": {
        "asset": "coolant-face",
        "fit": "stretch"
      }
    },
    {
      "id": "coolant",
      "name": "Coolant",
      "type": "gauge.arc",
      "x": 1670,
      "y": 289,
      "width": 220,
      "height": 220,
      "binding": {
        "signal": "engine.coolant.temp",
        "min": 60,
        "max": 120,
        "fallback": "zero"
      },
      "props": {
        "startAngle": 180,
        "sweepAngle": 180,
        "track": {
          "show": false
        },
        "fill": {
          "color": "$accent",
          "width": 23,
          "mode": "segments",
          "segments": 28,
          "segmentGap": 1.1,
          "zones": [
            {
              "from": 113.4,
              "to": 120,
              "color": "$danger"
            }
          ]
        },
        "ticks": {
          "major": 0
        },
        "labels": {
          "show": false
        },
        "needle": {
          "show": false
        }
      }
    },
    {
      "id": "fuel-face",
      "name": "Fuel face",
      "type": "image",
      "x": 1516,
      "y": 461,
      "width": 320,
      "height": 170,
      "props": {
        "asset": "fuel-face",
        "fit": "stretch"
      }
    },
    {
      "id": "fuel",
      "name": "Fuel",
      "type": "gauge.arc",
      "x": 1516,
      "y": 461,
      "width": 320,
      "height": 320,
      "binding": {
        "signal": "fuel.volume",
        "min": 0,
        "max": 59,
        "fallback": "zero"
      },
      "props": {
        "startAngle": 180,
        "sweepAngle": 180,
        "track": {
          "show": false
        },
        "fill": {
          "color": "$accent",
          "width": 33,
          "mode": "segments",
          "segments": 28,
          "segmentGap": 1.1,
          "zones": [
            {
              "from": 0,
              "to": 6.5,
              "color": "$danger"
            }
          ]
        },
        "ticks": {
          "major": 0
        },
        "labels": {
          "show": false
        },
        "needle": {
          "show": false
        }
      }
    },
    {
      "id": "speed",
      "name": "Speed",
      "type": "value.digital",
      "x": 645,
      "y": 325,
      "width": 612,
      "height": 198,
      "binding": {
        "signal": "vehicle.speed",
        "fallback": "dash"
      },
      "props": {
        "format": "0",
        "layout": "inline",
        "showUnit": false,
        "valueStyle": {
          "size": 202,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        },
        "unitStyle": {
          "size": 24,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        }
      }
    },
    {
      "id": "speed-unit",
      "name": "Speed unit",
      "type": "text",
      "x": 1164,
      "y": 472,
      "width": 122,
      "height": 38,
      "props": {
        "text": "km/h",
        "style": {
          "size": 32,
          "color": "$warning",
          "align": "center",
          "baseline": "middle"
        }
      }
    },
    {
      "id": "lcd-panel",
      "name": "LCD panel",
      "type": "rect",
      "x": 688,
      "y": 516,
      "width": 526,
      "height": 114,
      "props": {
        "radius": 9,
        "fill": "$surface"
      }
    },
    {
      "id": "clock",
      "name": "Clock",
